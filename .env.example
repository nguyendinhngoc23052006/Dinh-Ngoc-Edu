# Supabase — values from the dashboard (Project Settings → API). Placeholders only; never commit real keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# The Vercel↔Supabase integration injects the key under this name on previews;
# the client falls back to it when the publishable name is absent.
VITE_SUPABASE_ANON_KEY=

# The AI pipeline's secrets are NOT Vite vars and never ship to the browser.
# Set them in Supabase: Dashboard → Edge Functions → Secrets:
#   AI_API_KEY   (required) key for an OpenAI-compatible chat completions API
#   AI_BASE_URL  (optional) defaults to Gemini's OpenAI-compatible endpoint
#   AI_MODEL     (optional) defaults to gemini-2.5-flash
